import internal = "./internal.qui"
import native = "./native.qui"

// Package-owned mathematical constants. Core only provides the generic
// package-constant and exact-real atom mechanisms.
const real pi = real.atom("math", 1)
const real e = real.atom("math", 2)

// Repeated public names form ordinary Quidra generic specialization families.
// The generic members are real definitions, not prototypes: prototypes require
// one exact later definition and do not declare overload families.

T abs<T: numeric>(T value)
    T zero = value - value
    if value < zero
        return zero - value
    return value

T min<T: numeric>(T left, T right)
    if left < right
        return left
    return right

T max<T: numeric>(T left, T right)
    if left > right
        return left
    return right

T | error sqrt<T: floating>(T value)
    T zero = value - value
    if value < zero
        return error("math.sqrt requires a nonnegative value")
    return value ^ 0.5

T | error sin<T: floating>(T value)
    return error("math.sin is not implemented for this floating type")

T | error cos<T: floating>(T value)
    return error("math.cos is not implemented for this floating type")

T | error tan<T: floating>(T value)
    return error("math.tan is not implemented for this floating type")

T | error log<T: floating>(T value)
    T zero = value - value
    if value <= zero
        return error("math.log requires a positive value")
    return error("math.log is not implemented for this floating type")

T | error exp<T: floating>(T value)
    return error("math.exp is not implemented for this floating type")

T pow<T: floating>(T base, T exponent)
    return base ^ exponent

bool is_finite<T: floating>(T value)
    return true

int | error trunc<T: floating>(T value)
    return error("math.trunc is not implemented for this floating type")

int | error round<T: floating>(T value)
    return error("math.round is not implemented for this floating type")

int | error floor<T: floating>(T value)
    return error("math.floor is not implemented for this floating type")

int | error ceil<T: floating>(T value)
    return error("math.ceil is not implemented for this floating type")

int | error trunc(real32 value)
    if native.round_valid_f32(value, int32(1)) != int32(1)
        return error("math.trunc requires a finite value in int range")
    return int(native.round_value_f32(value, int32(1)))

int | error trunc(real64 value)
    if native.round_valid_f64(value, int32(1)) != int32(1)
        return error("math.trunc requires a finite value in int range")
    return int(native.round_value_f64(value, int32(1)))

int | error round(real32 value)
    if native.round_valid_f32(value, int32(2)) != int32(1)
        return error("math.round requires a finite value in int range")
    return int(native.round_value_f32(value, int32(2)))

int | error round(real64 value)
    if native.round_valid_f64(value, int32(2)) != int32(1)
        return error("math.round requires a finite value in int range")
    return int(native.round_value_f64(value, int32(2)))

int | error floor(real32 value)
    if native.round_valid_f32(value, int32(3)) != int32(1)
        return error("math.floor requires a finite value in int range")
    return int(native.round_value_f32(value, int32(3)))

int | error floor(real64 value)
    if native.round_valid_f64(value, int32(3)) != int32(1)
        return error("math.floor requires a finite value in int range")
    return int(native.round_value_f64(value, int32(3)))

int | error ceil(real32 value)
    if native.round_valid_f32(value, int32(4)) != int32(1)
        return error("math.ceil requires a finite value in int range")
    return int(native.round_value_f32(value, int32(4)))

int | error ceil(real64 value)
    if native.round_valid_f64(value, int32(4)) != int32(1)
        return error("math.ceil requires a finite value in int range")
    return int(native.round_value_f64(value, int32(4)))

real | error sqrt(real value)
    if value < real(0)
        return error("math.sqrt requires a nonnegative value")
    return real.unary("math", 1, value)

real sin(real value)
    return real.unary("math", 2, value)

real cos(real value)
    return real.unary("math", 3, value)

real tan(real value)
    return real.unary("math", 4, value)

real | error log(real value)
    if value <= real(0)
        return error("math.log requires a positive value")
    return real.unary("math", 5, value)

real exp(real value)
    return real.unary("math", 6, value)

real32 | error sqrt(real32 value)
    if value < real32(0)
        return error("math.sqrt requires a nonnegative value")
    return native.sqrt_f32(value)

real64 | error sqrt(real64 value)
    if value < 0.0
        return error("math.sqrt requires a nonnegative value")
    return native.sqrt_f64(value)

real32 sin(real32 value)
    return native.sin_f32(value)

real64 sin(real64 value)
    return native.sin_f64(value)

real32 cos(real32 value)
    return native.cos_f32(value)

real64 cos(real64 value)
    return native.cos_f64(value)

real32 tan(real32 value)
    return native.tan_f32(value)

real64 tan(real64 value)
    return native.tan_f64(value)

real32 | error log(real32 value)
    if value <= real32(0)
        return error("math.log requires a positive value")
    return native.log_f32(value)

real64 | error log(real64 value)
    if value <= 0.0
        return error("math.log requires a positive value")
    return native.log_f64(value)

real32 exp(real32 value)
    return native.exp_f32(value)

real64 exp(real64 value)
    return native.exp_f64(value)

real pow(real base, real exponent)
    return base ^ exponent

real32 pow(real32 base, real32 exponent)
    return native.pow_f32(base, exponent)

real64 pow(real64 base, real64 exponent)
    return native.pow_f64(base, exponent)

bool is_finite(real32 value)
    return native.is_finite_f32(value)

bool is_finite(real64 value)
    return native.is_finite_f64(value)

bool is_finite(real value)
    return true

tensor<real32> abs(tensor<real32> value)
    return internal.tensor_unary<real32>(value, int32(1))

tensor<real64> abs(tensor<real64> value)
    return internal.tensor_unary<real64>(value, int32(1))

tensor<real32> sqrt(tensor<real32> value)
    return internal.tensor_unary<real32>(value, int32(2))

tensor<real64> sqrt(tensor<real64> value)
    return internal.tensor_unary<real64>(value, int32(2))

tensor<real32> log(tensor<real32> value)
    return internal.tensor_unary<real32>(value, int32(3))

tensor<real64> log(tensor<real64> value)
    return internal.tensor_unary<real64>(value, int32(3))

tensor<real32> exp(tensor<real32> value)
    return internal.tensor_unary<real32>(value, int32(4))

tensor<real64> exp(tensor<real64> value)
    return internal.tensor_unary<real64>(value, int32(4))

tensor<T> sum<T: integer>(tensor<T> value)
    return internal.sum_all<T>(value)

tensor<T> sum<T: floating>(tensor<T> value)
    return internal.sum_all<T>(value)

tensor<T> mean<T: floating>(tensor<T> value)
    return internal.mean_all<T>(value)

tensor<T> sum_last<T: floating>(tensor<T> value)
    return internal.sum_last<T>(value)

tensor<T> max_last<T: integer>(tensor<T> value)
    return internal.max_last<T>(value)

tensor<T> min_last<T: integer>(tensor<T> value)
    return internal.min_last<T>(value)

tensor<T> max_last<T: floating>(tensor<T> value)
    return internal.max_last<T>(value)

tensor<T> min_last<T: floating>(tensor<T> value)
    return internal.min_last<T>(value)

tensor<T> max_all<T: integer>(tensor<T> value)
    return internal.max_all<T>(value)

tensor<T> min_all<T: integer>(tensor<T> value)
    return internal.min_all<T>(value)

tensor<T> max_all<T: floating>(tensor<T> value)
    return internal.max_all<T>(value)

tensor<T> min_all<T: floating>(tensor<T> value)
    return internal.min_all<T>(value)

real32 dot(tensor<real32> a, tensor<real32> b)
    int[] a_shape = int(a.shape())
    int[] b_shape = int(b.shape())
    if len(a_shape) != 1 or len(b_shape) != 1
        error("math.dot requires two rank-1 tensors")
    if a_shape[0] != b_shape[0]
        error("math.dot requires equal vector lengths")
    return internal.matmul_native<real32>(a, b).item()

real64 dot(tensor<real64> a, tensor<real64> b)
    int[] a_shape = int(a.shape())
    int[] b_shape = int(b.shape())
    if len(a_shape) != 1 or len(b_shape) != 1
        error("math.dot requires two rank-1 tensors")
    if a_shape[0] != b_shape[0]
        error("math.dot requires equal vector lengths")
    return internal.matmul_native<real64>(a, b).item()

T dot<T: integer>(tensor<T> a, tensor<T> b)
    int[] a_shape = int(a.shape())
    int[] b_shape = int(b.shape())
    if len(a_shape) != 1 or len(b_shape) != 1
        error("math.dot requires two rank-1 tensors")
    if a_shape[0] != b_shape[0]
        error("math.dot requires equal vector lengths")
    return internal.matmul<T>(a, b).item()

tensor<T> matmul<T: integer>(tensor<T> a, tensor<T> b)
    return internal.matmul<T>(a, b)

tensor<real32> matmul(tensor<real32> a, tensor<real32> b)
    int[] a_shape = int(a.shape())
    int[] b_shape = int(b.shape())
    int a_rank = int(len(a_shape))
    int b_rank = int(len(b_shape))

    if a_rank < 1 or (b_rank != 1 and b_rank != 2)
        error("math.matmul requires left rank >= 1 and right rank 1 or 2")
    if a_shape[a_rank - 1] <= 0 or b_shape[0] != a_shape[a_rank - 1]
        error("math.matmul inner dimensions do not match")

    if b_rank == 2 and b_shape[1] <= 0
        error("math.matmul requires a positive output width")

    int output_rank = a_rank
    if b_rank == 1
        output_rank = a_rank - 1
    int[] output_shape = array(nat(output_rank), fill = 1)
    for axis in range(a_rank - 1)
        output_shape[axis] = a_shape[axis]
    if b_rank == 2
        output_shape[a_rank - 1] = b_shape[1]

    // CUDA keeps its untracked cuBLAS path unchanged.
    if not a.is_tracked() and not b.is_tracked()
        int32 left_cuda = native.cuda_device_f32(&a)
        int32 right_cuda = native.cuda_device_f32(&b)
        if left_cuda >= int32(0) and right_cuda == left_cuda
            tensor<real32> left = a
            tensor<real32> right = b
            if not left.is_contiguous()
                left = left.contiguous()
            if not right.is_contiguous()
                right = right.contiguous()
            tensor<real32> output = tensor.zeros<real32>(
                nat(output_shape),
                gpu = nat(left_cuda)
            )
            if native.matmul_cuda_f32(&left, &right, &output) == int32(0)
                return output

    // CPU, the fake test GPU, and Metal use Math's backend-neutral native
    // product for tracked and untracked tensors alike; other placements fall
    // back to the portable composition inside.
    return internal.matmul_native<real32>(a, b)

tensor<real64> matmul(tensor<real64> a, tensor<real64> b)
    return internal.matmul_native<real64>(a, b)
