import internal = "./internal.qui"
import native = "./native.qui"

// Package-owned mathematical constants. Core only provides the generic
// package-constant and exact-real atom mechanisms.
const literal real pi = real.atom("math", 1)
const literal real e = real.atom("math", 2)

// Repeated public names form ordinary Quidra generic specialization families.
// The generic members are real definitions, not prototypes: prototypes require
// one exact later definition and do not declare overload families.

T abs<T: numeric>(extend T value)
    T zero = value - value
    if value < zero
        return zero - value
    return value

T min<T: numeric>(T left, T right)
    if left < right
        return left
    return right

T max<T: numeric>(T left, T right)
    if left > right
        return left
    return right

T | error sqrt<T: floating>(extend T value)
    T zero = value - value
    if value < zero
        return error("math.sqrt requires a nonnegative value", code = "MATH_DOMAIN")
    return value ^ 0.5

T | error sin<T: floating>(T value)
    return T(native.sin_f32(real32(value)))

T | error cos<T: floating>(T value)
    return T(native.cos_f32(real32(value)))

T | error tan<T: floating>(T value)
    return T(native.tan_f32(real32(value)))

T | error log<T: floating>(extend T value)
    T zero = value - value
    if value <= zero
        return error("math.log requires a positive value", code = "MATH_DOMAIN")
    return T(native.log_f32(real32(value)))

T | error exp<T: floating>(extend T value)
    return T(native.exp_f32(real32(value)))

T pow<T: floating>(T base, T exponent)
    return base ^ exponent

bool is_finite<T: floating>(T value)
    return true

int | error trunc<T: floating>(T value)
    real32 widened = real32(value)
    if native.round_valid_f32(widened, int32(1)) != int32(1)
        return error("math.trunc requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f32(widened, int32(1)))

int | error round<T: floating>(T value)
    real32 widened = real32(value)
    if native.round_valid_f32(widened, int32(2)) != int32(1)
        return error("math.round requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f32(widened, int32(2)))

int | error floor<T: floating>(T value)
    real32 widened = real32(value)
    if native.round_valid_f32(widened, int32(3)) != int32(1)
        return error("math.floor requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f32(widened, int32(3)))

int | error ceil<T: floating>(T value)
    real32 widened = real32(value)
    if native.round_valid_f32(widened, int32(4)) != int32(1)
        return error("math.ceil requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f32(widened, int32(4)))

int | error trunc(real32 value)
    if native.round_valid_f32(value, int32(1)) != int32(1)
        return error("math.trunc requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f32(value, int32(1)))

int | error trunc(real64 value)
    if native.round_valid_f64(value, int32(1)) != int32(1)
        return error("math.trunc requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f64(value, int32(1)))

int | error round(real32 value)
    if native.round_valid_f32(value, int32(2)) != int32(1)
        return error("math.round requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f32(value, int32(2)))

int | error round(real64 value)
    if native.round_valid_f64(value, int32(2)) != int32(1)
        return error("math.round requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f64(value, int32(2)))

int | error floor(real32 value)
    if native.round_valid_f32(value, int32(3)) != int32(1)
        return error("math.floor requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f32(value, int32(3)))

int | error floor(real64 value)
    if native.round_valid_f64(value, int32(3)) != int32(1)
        return error("math.floor requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f64(value, int32(3)))

int | error ceil(real32 value)
    if native.round_valid_f32(value, int32(4)) != int32(1)
        return error("math.ceil requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f32(value, int32(4)))

int | error ceil(real64 value)
    if native.round_valid_f64(value, int32(4)) != int32(1)
        return error("math.ceil requires a finite value in int range", code = "MATH_RANGE")
    return int(native.round_value_f64(value, int32(4)))

real | error sqrt(extend real value)
    if value < real(0)
        return error("math.sqrt requires a nonnegative value", code = "MATH_DOMAIN")
    return real.unary("math", 257, value)

real sin(real value)
    return real.unary("math", 258, value)

real cos(real value)
    return real.unary("math", 259, value)

real tan(real value)
    return real.unary("math", 260, value)

real | error log(extend real value)
    if value <= real(0)
        return error("math.log requires a positive value", code = "MATH_DOMAIN")
    return real.unary("math", 261, value)

real exp(extend real value)
    return real.unary("math", 262, value)

real32 | error sqrt(extend real32 value)
    if value < real32(0)
        return error("math.sqrt requires a nonnegative value", code = "MATH_DOMAIN")
    return native.sqrt_f32(value)

real64 | error sqrt(extend real64 value)
    if value < 0.0
        return error("math.sqrt requires a nonnegative value", code = "MATH_DOMAIN")
    return native.sqrt_f64(value)

real32 sin(real32 value)
    return native.sin_f32(value)

real64 sin(real64 value)
    return native.sin_f64(value)

real32 cos(real32 value)
    return native.cos_f32(value)

real64 cos(real64 value)
    return native.cos_f64(value)

real32 tan(real32 value)
    return native.tan_f32(value)

real64 tan(real64 value)
    return native.tan_f64(value)

real32 | error log(extend real32 value)
    if value <= real32(0)
        return error("math.log requires a positive value", code = "MATH_DOMAIN")
    return native.log_f32(value)

real64 | error log(extend real64 value)
    if value <= 0.0
        return error("math.log requires a positive value", code = "MATH_DOMAIN")
    return native.log_f64(value)

real32 exp(extend real32 value)
    return native.exp_f32(value)

real64 exp(extend real64 value)
    return native.exp_f64(value)

real pow(real base, real exponent)
    return real.op("math", 263, base, exponent)

real32 pow(real32 base, real32 exponent)
    return native.pow_f32(base, exponent)

real64 pow(real64 base, real64 exponent)
    return native.pow_f64(base, exponent)

bool is_finite(real32 value)
    return native.is_finite_f32(value)

bool is_finite(real64 value)
    return native.is_finite_f64(value)

bool is_finite(real value)
    return true

// Half tensor operations widen exactly, compute in real32, and round once
// when converted back. Differentiable floating casts keep the input's target.
tensor<real16> abs(extend tensor<real16> value)
    return real16(internal.tensor_unary<real32>(real32(value), int32(1)))

tensor<real16b> abs(extend tensor<real16b> value)
    return real16b(internal.tensor_unary<real32>(real32(value), int32(1)))

tensor<real16> sqrt(extend tensor<real16> value)
    return real16(internal.tensor_unary<real32>(real32(value), int32(2)))

tensor<real16b> sqrt(extend tensor<real16b> value)
    return real16b(internal.tensor_unary<real32>(real32(value), int32(2)))

tensor<real16> log(extend tensor<real16> value)
    return real16(internal.tensor_unary<real32>(real32(value), int32(3)))

tensor<real16b> log(extend tensor<real16b> value)
    return real16b(internal.tensor_unary<real32>(real32(value), int32(3)))

tensor<real16> exp(extend tensor<real16> value)
    return real16(internal.tensor_unary<real32>(real32(value), int32(4)))

tensor<real16b> exp(extend tensor<real16b> value)
    return real16b(internal.tensor_unary<real32>(real32(value), int32(4)))

tensor<real32> abs(extend tensor<real32> value)
    return internal.tensor_unary<real32>(value, int32(1))

tensor<real64> abs(extend tensor<real64> value)
    return internal.tensor_unary<real64>(value, int32(1))

tensor<real32> sqrt(extend tensor<real32> value)
    return internal.tensor_unary<real32>(value, int32(2))

tensor<real64> sqrt(extend tensor<real64> value)
    return internal.tensor_unary<real64>(value, int32(2))

tensor<real32> log(extend tensor<real32> value)
    return internal.tensor_unary<real32>(value, int32(3))

tensor<real64> log(extend tensor<real64> value)
    return internal.tensor_unary<real64>(value, int32(3))

tensor<real32> exp(extend tensor<real32> value)
    return internal.tensor_unary<real32>(value, int32(4))

tensor<real64> exp(extend tensor<real64> value)
    return internal.tensor_unary<real64>(value, int32(4))

// Array mappings copy their input, then update that private copy. The recursive
// helpers retain the complete type of each row, including fixed inner extents.
// Scalar specializations use inferred calls so real64 and exact real keep their
// scalar kernels. Fallible leaves propagate the original error with try.
private void .array_abs<T: numeric>(T &value)
    value = abs(value)

private void .array_abs<T>(T &value)
    for 0 <= nat index < len(value)
        .array_abs(&value[index])

private void | error .array_sqrt<T: numeric>(T &value)
    T | error mapped = sqrt(value)
    value = try mapped
    return

private void | error .array_sqrt<T>(T &value)
    for 0 <= nat index < len(value)
        try .array_sqrt(&value[index])
    return

private void | error .array_log<T: numeric>(T &value)
    T | error mapped = log(value)
    value = try mapped
    return

private void | error .array_log<T>(T &value)
    for 0 <= nat index < len(value)
        try .array_log(&value[index])
    return

private void | error .array_exp<T: numeric>(T &value)
    T | error mapped = exp(value)
    value = try mapped
    return

private void | error .array_exp<T>(T &value)
    for 0 <= nat index < len(value)
        try .array_exp(&value[index])
    return

T[] abs<T>(extend T[] value)
    T[] result = value
    .array_abs(&result)
    return result

T[] | error sqrt<T>(extend T[] value)
    T[] result = value
    try .array_sqrt(&result)
    return result

T[] | error log<T>(extend T[] value)
    T[] result = value
    try .array_log(&result)
    return result

T[] | error exp<T>(extend T[] value)
    T[] result = value
    try .array_exp(&result)
    return result

T sum<T: numeric>(extend T[] value)
    T total = T(0)
    for auto element = value[]
        total = total + element
    return total

tensor<T> sum<T: integer>(extend tensor<T> value)
    return internal.sum_all<T>(value)

tensor<T> sum<T: floating>(extend tensor<T> value)
    return internal.sum_all<T>(value)

T mean<T: numeric>(extend T[] value)
    if len(value) == 0
        error("math.mean requires at least one element", code = "MATH_SHAPE")
    T total = sum<T>(value)
    T count = T(len(value))
    return total / count

real mean<T: integer>(extend T[] value)
    if len(value) == 0
        error("math.mean requires at least one element", code = "MATH_SHAPE")
    real total = 0.0
    for auto element = value[]
        total = total + real(element)
    return total / real(len(value))

tensor<T> mean<T: floating>(extend tensor<T> value)
    return internal.mean_all<T>(value)

tensor<T> sum_last<T: floating>(extend tensor<T> value)
    return internal.sum_last<T>(value)

tensor<T> max_last<T: integer>(extend tensor<T> value)
    return internal.max_last<T>(value)

tensor<T> min_last<T: integer>(extend tensor<T> value)
    return internal.min_last<T>(value)

tensor<T> max_last<T: floating>(extend tensor<T> value)
    return internal.max_last<T>(value)

tensor<T> min_last<T: floating>(extend tensor<T> value)
    return internal.min_last<T>(value)

T max_all<T: ordered>(extend T[] value)
    if len(value) == 0
        error("math.max requires at least one element", code = "MATH_SHAPE")
    T best = value[0]
    for 1 <= nat index < len(value)
        T candidate = value[index]
        if candidate > best
            best = candidate
    return best

T min_all<T: ordered>(extend T[] value)
    if len(value) == 0
        error("math.min requires at least one element", code = "MATH_SHAPE")
    T best = value[0]
    for 1 <= nat index < len(value)
        T candidate = value[index]
        if candidate < best
            best = candidate
    return best

tensor<T> max_all<T: integer>(extend tensor<T> value)
    return internal.max_all<T>(value)

tensor<T> min_all<T: integer>(extend tensor<T> value)
    return internal.min_all<T>(value)

tensor<T> max_all<T: floating>(extend tensor<T> value)
    return internal.max_all<T>(value)

tensor<T> min_all<T: floating>(extend tensor<T> value)
    return internal.min_all<T>(value)

// An array dot product preserves the element type and checks each operation.
// In particular, fixed-width intermediate multiplication and addition cannot
 // silently widen or reorder, and an empty pair returns the additive identity.
T dot<T: numeric>(extend T[] a, T[] b)
    if len(a) != len(b)
        error("math.dot requires equal vector lengths", code = "MATH_SHAPE")
    T total = T(0)
    for 0 <= nat index < len(a)
        total += a[index] * b[index]
    return total

real32 dot(extend tensor<real32> a, tensor<real32> b)
    int[] a_shape = int(a.shape())
    int[] b_shape = int(b.shape())
    if len(a_shape) != 1 or len(b_shape) != 1
        error("math.dot requires two rank-1 tensors", code = "MATH_SHAPE")
    if a_shape[0] != b_shape[0]
        error("math.dot requires equal vector lengths", code = "MATH_SHAPE")
    return internal.matmul_native<real32>(a, b).item()

real64 dot(extend tensor<real64> a, tensor<real64> b)
    int[] a_shape = int(a.shape())
    int[] b_shape = int(b.shape())
    if len(a_shape) != 1 or len(b_shape) != 1
        error("math.dot requires two rank-1 tensors", code = "MATH_SHAPE")
    if a_shape[0] != b_shape[0]
        error("math.dot requires equal vector lengths", code = "MATH_SHAPE")
    return internal.matmul_native<real64>(a, b).item()

T dot<T: integer>(extend tensor<T> a, tensor<T> b)
    int[] a_shape = int(a.shape())
    int[] b_shape = int(b.shape())
    if len(a_shape) != 1 or len(b_shape) != 1
        error("math.dot requires two rank-1 tensors", code = "MATH_SHAPE")
    if a_shape[0] != b_shape[0]
        error("math.dot requires equal vector lengths", code = "MATH_SHAPE")
    return internal.matmul<T>(a, b).item()

tensor<T> matmul<T: integer>(extend tensor<T> a, tensor<T> b)
    return internal.matmul<T>(a, b)

tensor<real32> matmul(extend tensor<real32> a, tensor<real32> b)
    int[] a_shape = int(a.shape())
    int[] b_shape = int(b.shape())
    int a_rank = int(len(a_shape))
    int b_rank = int(len(b_shape))

    if a_rank < 1 or (b_rank != 1 and b_rank != 2)
        error("math.matmul requires left rank >= 1 and right rank 1 or 2", code = "MATH_SHAPE")
    if a_shape[a_rank - 1] <= 0 or b_shape[0] != a_shape[a_rank - 1]
        error("math.matmul inner dimensions do not match", code = "MATH_SHAPE")

    if b_rank == 2 and b_shape[1] <= 0
        error("math.matmul requires a positive output width", code = "MATH_SHAPE")

    int output_rank = a_rank
    if b_rank == 1
        output_rank = a_rank - 1
    int[] output_shape = array(nat(output_rank), fill = 1)
    for 0 <= int axis < a_rank - 1
        output_shape[axis] = a_shape[axis]
    if b_rank == 2
        output_shape[a_rank - 1] = b_shape[1]

    // CUDA keeps its untracked cuBLAS path unchanged.
    if not a.is_tracked() and not b.is_tracked()
        int32 left_cuda = native.cuda_device_f32(a)
        int32 right_cuda = native.cuda_device_f32(b)
        if left_cuda >= int32(0) and right_cuda == left_cuda
            tensor<real32> left = a
            tensor<real32> right = b
            if not left.is_contiguous()
                left = left.contiguous()
            if not right.is_contiguous()
                right = right.contiguous()
            tensor<real32> output = tensor.zeros<real32>(
                nat(output_shape),
                gpu = nat(left_cuda)
            )
            if native.matmul_cuda_f32(left, right, &output) == int32(0)
                return output

    // CPU, the fake test GPU, and Metal use Math's backend-neutral native
    // product for tracked and untracked tensors alike; other placements fall
    // back to the portable composition inside.
    return internal.matmul_native<real32>(a, b)

tensor<real64> matmul(extend tensor<real64> a, tensor<real64> b)
    return internal.matmul_native<real64>(a, b)
