import math

bool same_shape(nat[] left, nat[] right)
    return left == right

real16 sin16_value := math.sin(real16(0))
println(sin16_value == real16(0))
real16 cos16_value := math.cos(real16(0))
println(cos16_value == real16(1))
real16 log16_value := math.log(real16(1))
println(log16_value == real16(0))
real16 exp16_value := math.exp(real16(0))
println(exp16_value == real16(1))
real16 sqrt16_value := math.sqrt(real16(4))
println(sqrt16_value == real16(2))
int floor16_value := math.floor(real16(-1.5))
println(floor16_value == int(-2))
real16b sin16b_value := math.sin(real16b(0))
println(sin16b_value == real16b(0))
real16b cos16b_value := math.cos(real16b(0))
println(cos16b_value == real16b(1))
real16b log16b_value := math.log(real16b(1))
println(log16b_value == real16b(0))
real16b exp16b_value := math.exp(real16b(0))
println(exp16b_value == real16b(1))
real16b sqrt16b_value := math.sqrt(real16b(4))
println(sqrt16b_value == real16b(2))
int floor16b_value := math.floor(real16b(-1.5))
println(floor16b_value == int(-2))
tensor<real16> empty0 := tensor.zeros<real16>([3, 0])
println(same_shape(math.sum_last(empty0).shape(), empty0.shape()) and same_shape(math.max_last(empty0).shape(), empty0.shape()) and same_shape(math.min_last(empty0).shape(), empty0.shape()))
tensor<real16b> empty1 := tensor.zeros<real16b>([3, 0])
println(same_shape(math.sum_last(empty1).shape(), empty1.shape()) and same_shape(math.max_last(empty1).shape(), empty1.shape()) and same_shape(math.min_last(empty1).shape(), empty1.shape()))
tensor<real32> empty2 := tensor.zeros<real32>([3, 0])
println(same_shape(math.sum_last(empty2).shape(), empty2.shape()) and same_shape(math.max_last(empty2).shape(), empty2.shape()) and same_shape(math.min_last(empty2).shape(), empty2.shape()))
tensor<real64> empty3 := tensor.zeros<real64>([3, 0])
println(same_shape(math.sum_last(empty3).shape(), empty3.shape()) and same_shape(math.max_last(empty3).shape(), empty3.shape()) and same_shape(math.min_last(empty3).shape(), empty3.shape()))

// Empty whole-tensor sums retain their source dtype and zero Jacobian.
tensor<real16> tracked_empty16 := tensor.zeros<real16>([0]).track()
tensor<real16> total_empty16 := math.sum(tracked_empty16)
println(total_empty16.is_tracked() and total_empty16.item() == real16(0) and #total_empty16.shape() == 0)
total_empty16.backward(&tracked_empty16)
tensor<real16> gradient_empty16 := tracked_empty16.grad
println(gradient_empty16.shape() == tracked_empty16.shape())

tensor<real16b> tracked_empty16b := tensor.zeros<real16b>([0]).track()
tensor<real16b> total_empty16b := math.sum(tracked_empty16b)
println(total_empty16b.is_tracked() and total_empty16b.item() == real16b(0) and #total_empty16b.shape() == 0)
total_empty16b.backward(&tracked_empty16b)
tensor<real16b> gradient_empty16b := tracked_empty16b.grad
println(gradient_empty16b.shape() == tracked_empty16b.shape())
