import math

int[] values = [1, -2, 3, -4, 5]
int positive_square_sum = (values[values > 0] ^ 2).sum()
int range_square_sum = (:9 ^ 2).sum()
int[] selection = values[[4, 2, 0]]
int[] expected_selection = [5, 3, 1]
int[] expected_slice = [1, -2, 3, -4]
nat[] expected_indices = [0, 1, 2, 3, 4]
real64[] squares = [1.0, 4.0, 9.0]
real64 free_root_sum = math.sum<real64>(math.sqrt(squares))
real64 method_root_sum = squares.sqrt().sum<real64>()
print(free_root_sum == real64(6) and method_root_sum == free_root_sum and
      positive_square_sum == 35 and range_square_sum == 285 and
      selection == expected_selection and values[:3] == expected_slice and
      values.indices() == expected_indices)
