import math

// The typed bindings reject accidental promotion of the reduction result.
bool sum_matches<T: numeric>(T[] values, T expected, T zero)
    T total = math.sum(values)
    T[] empty = []
    T empty_total = math.sum(empty)
    return total == expected and empty_total == zero

print(sum_matches<int8>([1, -2, 4], 3, 0))
print(NL)
