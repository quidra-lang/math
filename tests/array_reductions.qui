bool integer_mean_matches<T: integer>(T[] values)
    real average = math.mean(values)
    return average == real(3) / real(2)

print(integer_mean_matches<int8>([1, 2]))
print(NL)
print(integer_mean_matches<int16>([1, 2]))
print(NL)
