// Integer averaging is exact before division, including a narrow-type sum.
int8[] large8 = [100, 100]
int[] huge = [18446744073709551616, 18446744073709551617]
print(math.mean(large8) == real(100) and math.mean(huge) == real(36893488147419103233) / real(2))
print(NL)

// A pairwise tree or wider accumulator would return a different result.
real16[] ordered16 = [2048.0, 1.0, -2048.0, 1.0]
real16b[] ordered16b = [256.0, 1.0, -256.0, 1.0]
real32[] ordered32 = [16777216.0, 1.0, -16777216.0, 1.0]
real64[] ordered64 = [9007199254740992.0, 1.0, -9007199254740992.0, 1.0]
print(math.sum(ordered16) == real16(1) and math.sum(ordered16b) == real16b(1) and math.sum(ordered32) == real32(1) and math.sum(ordered64) == real64(1))
print(NL)
print(math.mean(ordered16) == real16(0.25) and math.mean(ordered16b) == real16b(0.25) and math.mean(ordered32) == real32(0.25) and math.mean(ordered64) == real64(0.25))
print(NL)

int[] values = [-2, 1, 2, -3, 3]
print(math.sum([for auto x = values[] if x > 0 then x * x]) == 14)
print(NL)
print(math.sum([for auto x = values[] if x > 10 then x * x]) == 0)
print(NL)

real32[] zeros = [-0.0]
print(math.sum(zeros).string() == "0.0")
print(NL)
real32[] tied = [-0.0, 0.0]
real32[] singleton = [2.0]
print(math.min_all(tied).string() == "-0.0" and math.max_all(tied).string() == "-0.0" and math.min_all(singleton) == real32(2) and math.max_all(singleton) == real32(2))
print(NL)

// Array dispatch must leave existing tensor reduction and autograd intact.
tensor<int32> integers = tensor.ones<int32>([3])
tensor<real32> tracked = tensor.ones<real32>([3]).track()
tensor<real32> total = math.sum(tracked)
total.backward(&tracked)
print(math.sum(integers).item() == int32(3) and total.untrack().item() == real32(3) and tracked.grad[2].item() == real32(1))
print(NL)
print(math.mean(tracked).untrack().item() == real32(1) and math.min_all(integers).item() == int32(1) and math.max_all(tracked).untrack().item() == real32(1))
print(NL)

bool dot_matches<T: numeric>(T[] left, T[] right, T expected)
    T computed = math.dot(left, right)
    return computed == expected

print(dot_matches<int8>([1, 2, 3], [4, 5, 6], 32))
print(NL)
print(dot_matches<int>([18446744073709551616, 2], [2, 3], 36893488147419103238))
print(NL)
print(dot_matches<real32>([0.5, 1.0], [2.0, -3.0], -2.0))
print(NL)
print(dot_matches<com32>([1.0 + 2.0i], [3.0 - 4.0i], 11.0 + 2.0i))
print(NL)
print(dot_matches<int>([], [], 0))
print(NL)

// Scalar functions applied elementwise to array values; outputs are separate
// arrays and source values remain unchanged.
real64[] input_sqrt = [1.0, 4.0, 9.0]
real64[] sqrt_values = math.sqrt(input_sqrt)
real64[] sqrt_expected = [1.0, 2.0, 3.0]
print(sqrt_values == sqrt_expected and input_sqrt == [1.0, 4.0, 9.0])
print(NL)

real32[] input_abs = [-2.0, 0.0, 3.0]
real32[] abs_values = math.abs(input_abs)
real32[] abs_expected = [2.0, 0.0, 3.0]
print(abs_values == abs_expected and input_abs == [-2.0, 0.0, 3.0])
print(NL)

real64[] input_exp = [0.0, 1.0]
real64[] exp_values = math.exp(input_exp)
print(exp_values[0] == 1.0 and exp_values[1] > 2.0 and exp_values[1] < 3.0)
print(NL)

real64[] input_log = [1.0]
real64[] log_values = math.log(input_log)
print(log_values == [0.0])
print(NL)

real32[] empty_values = []
print(math.sqrt(empty_values) == empty_values and
      math.exp(empty_values) == empty_values and
      math.log(empty_values) == empty_values and
      math.abs(empty_values) == empty_values)
print(NL)
