import math

real checked_real(real | error result)
    real value = result
    return value

print.line(real(math.pi).string() == "π")
print.line(real(math.e).string() == "e")
print.line(checked_real(math.sqrt(real(8))).string() == "2√2")
print.line(checked_real(math.sqrt(real(144))) == real(12))
print.line(math.sin(real(0)) == real(0) and math.cos(real(0)) == real(1))
print.line(math.tan(real(0)) == real(0) and checked_real(math.log(real(1))) == real(0))
print.line(math.exp(real(0)) == real(1))
print.line(math.sin(real(math.pi)) == real(0) and math.cos(real(math.pi)) == real(-1))
print.line(checked_real(math.log(math.exp(real(2)))) == real(2))
print.line(math.exp(checked_real(math.log(real(3)))) == real(3))
print.line(math.pi > real(3) and math.pi < real(22) / real(7))
print.line(math.e > real(2718) / real(1000) and math.e < real(2719) / real(1000))
print.line(math.sin(real(1)) > real(84) / real(100) and math.sin(real(1)) < real(85) / real(100))
print.line(checked_real(math.log(real(2))) > real(69) / real(100) and checked_real(math.log(real(2))) < real(70) / real(100))
print.line(math.exp(real(1)) > real(2718) / real(1000) and math.exp(real(1)) < real(2719) / real(1000))
print.line(math.pow(real(2), real(math.pi)) > real(8) and math.pow(real(2), real(math.pi)) < real(9))
print.line(math.pow(real(-2), real(3)) == real(-8))
